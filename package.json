{
  "name": "beliefatlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --test --test-concurrency=1 tests/*.test.ts",
    "db:seed:questions": "tsx --env-file-if-exists=.env.local db/seed-questions.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env.local db/seed.ts",
    "seed:load": "tsx --env-file-if-exists=.env.local db/seed-data.ts load",
    "seed:status": "tsx --env-file-if-exists=.env.local db/seed-data.ts status",
    "seed:remove": "tsx --env-file-if-exists=.env.local db/seed-data.ts remove",
    "test-data:remove": "tsx --env-file-if-exists=.env.local db/seed-data.ts remove-test",
    "ai:answers": "tsx --env-file-if-exists=.env.local db/ai-answers.ts",
    "admin:role": "tsx --env-file-if-exists=.env.local db/set-role.ts",
    "translate:drafts": "tsx --env-file-if-exists=.env.local db/translate-drafts.ts",
    "translate:grant": "tsx --env-file-if-exists=.env.local db/translator.ts",
    "embeddings:index": "tsx --env-file-if-exists=.env.local db/embed-questions.ts",
    "jobs:work": "tsx --env-file-if-exists=.env.local lib/jobs/cli.ts",
    "load:votes": "tsx --env-file-if-exists=.env.local scripts/load/votes.ts",
    "load:test": "npm run load:votes -- --rate=1000 --seconds=10",
    "db:migrate:deploy": "tsx db/migrate.ts",
    "vercel-build": "npm run db:migrate:deploy && tsx db/preview-seed.ts && next build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "echarts": "^6.1.0",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
