# ---- Required ----
DATABASE_URL=postgres://beliefatlas:beliefatlas@localhost:5432/beliefatlas
# Secret used to hash phone numbers. Generate once (openssl rand -hex 32) and never change it:
# a new value orphans every existing account.
PHONE_PEPPER=change-me-to-a-long-random-string
# The site's public address, used in Stripe return links. Defaults to the Vercel URL.
SITE_URL=http://localhost:3000

# ---- Data ----
# Breakdowns (e.g. public vs private) are withheld for groups smaller than this. Default 50
# (5 on a preview in test mode); 5 is handy for local development with demo data.
MIN_GROUP_SIZE=5
# Comma-separated API keys. Callers send one as "Authorization: Bearer <key>".
API_KEYS=
# Reports from this many accounts take a question out of feeds until a moderator reviews it.
REPORT_THRESHOLD=5
# Undecided rule, off: remove a question outright once it has 50+ votes and 25%+ of its voters
# reported it. Off means heavy reports only hide it until a moderator looks.
REPORT_AUTO_REMOVE=false
# Active demerit points that bring a temporary ban from asking (1, 7, 30, then 90 days), and
# how long a demerit lasts.
DEMERIT_BAN_POINTS=2
DEMERIT_DAYS=180
# Grammar suggestions from your own LanguageTool server (free, self-hosted; never blocks).
# Leave empty to use the built-in rule checks only.
LANGUAGETOOL_URL=

# ---- Paid services stay off ----
# Nothing that costs money or handles payments runs until its flag is "true", even with keys
# set. No keys belong in this file or anywhere in the repository; set them in Vercel only.
TWILIO_ENABLED=false
STRIPE_ENABLED=false

# ---- Phone verification (Twilio Verify) ----
# Without these (and TWILIO_ENABLED=true), development uses a code printed to the server log;
# production refuses signups.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Development only: fix the code instead of a random one (used by automated tests).
SMS_DEV_CODE=
# Line-type lookup before texting a code. "twilio" uses Twilio Lookup (billed per lookup) to turn
# away VoIP and virtual numbers; unset means no lookup.
PHONE_LINE_CHECK=
# Set to false to also turn away numbers the lookup can't classify.
PHONE_ALLOW_UNKNOWN=true

# ---- Bot check on signup (Cloudflare Turnstile, free) ----
# Without these, development skips the check; production refuses signups.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Membership (Stripe) ----
# Without these (and STRIPE_ENABLED=true), development switches tiers directly; production
# shows "opens soon".
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- AI (optional, paid API: off unless AI_ENABLED=true) ----
AI_ENABLED=false
# Screens new questions for repeats and harm, and powers npm run ai:answers.
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-haiku-5-5

# ---- Legal pages ----
CONTACT_EMAIL=
OPERATOR_NAME=

# Logs: lowest level written (debug, info, warn, error)
LOG_LEVEL=info

# ---- Headless front door (lib/headless; design: belief-map/headless-front-door.md) ----
# Off by default. Keep off in production until the domain is chosen. When off, every
# /api/headless/v1 route answers 404 and the vote page ignores headless return addresses.
HEADLESS_ENABLED=false
# The server relay (orgs' servers send taps for their linked users). Off by recommendation:
# the org would see each person's answer.
HEADLESS_RELAY_ENABLED=false
# Test-only relay credentials, "org-slug:key,org-slug:key" (keys 16+ characters). Ignored in
# production. No real org credentials are issued.
HEADLESS_TEST_ORG_KEYS=
